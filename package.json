{
  "name": "scratch-tab-build",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types infra/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --test infra/test.mjs",
    "format": "prettier --write \"dev/frontend/src/**/*.{ts,tsx}\" \"dev/frontend/ui/style/**/*.css\" \"infra/*.{ts,mjs}\"",
    "format:check": "prettier --check \"dev/frontend/src/**/*.{ts,tsx}\" \"dev/frontend/ui/style/**/*.css\" \"infra/*.{ts,mjs}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdown-it": "15.0.3",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "type-fest": "4.41.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "mermaid": "12.2.0",
    "preact": "11.0.1"
  }
}

{
  "name": "scratch-tab-build",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types infra/build.ts",
    "typecheck": "tsc --noEmit && npm --prefix dev/frontend run typecheck",
    "test": "npm run typecheck && npm run test:frontend && npm run test:backend && npm run test:infra",
    "format": "prettier --write \"dev/frontend/src/**/*.{ts,tsx}\" \"dev/frontend/ui/style/**/*.css\" \"infra/*.{ts,mjs}\" \"dev/frontend/tests/**/*.ts\" \"dev/frontend/vitest.config.ts\"",
    "format:check": "prettier --check \"dev/frontend/src/**/*.{ts,tsx}\" \"dev/frontend/ui/style/**/*.css\" \"infra/*.{ts,mjs}\" \"dev/frontend/tests/**/*.ts\" \"dev/frontend/vitest.config.ts\"",
    "prepare": "husky",
    "test:frontend": "npm --prefix dev/frontend test",
    "test:backend": "bash backend/tests/run.sh",
    "test:infra": "bash infra/test.sh",
    "test:host": "bash backend/tests/host.sh",
    "package": "bash infra/package.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdown-it": "15.0.3",
    "playwright": "1.62.1",
    "prettier": "3.9.10",
    "type-fest": "4.41.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "mermaid": "12.2.0",
    "preact": "11.0.1"
  }
}
